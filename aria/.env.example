# Aria — Environment Variable Template
# Copy to .env and fill in your values. Never commit .env to git.
# Full reference: docs/configuration.md

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=Aria
APP_VERSION=0.1.0
DEBUG=true                           # set to false in production
LOG_LEVEL=INFO                       # DEBUG / INFO / WARNING / ERROR

# ── Service backend selection ────────────────────────────────────────────────
# Development defaults (local GPU)
STT_BACKEND=local                    # local | deepgram | gladia
LLM_BACKEND=ollama                   # ollama | claude
TTS_BACKEND=piper                    # piper | elevenlabs | openai
DIAR_BACKEND=local                   # local | deepgram | gladia
TRANSLATION_BACKEND=helsinki         # helsinki | deepl

# ── Local ML settings (dev only) ─────────────────────────────────────────────
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=float16         # float16 (GPU) | int8 (CPU)
WHISPER_DEVICE=cuda                  # cuda | cpu
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
PIPER_VOICE_DIR=/opt/piper/voices

# ── API Keys ─────────────────────────────────────────────────────────────────
HF_TOKEN=                            # REQUIRED for pyannote diarization (dev)
ANTHROPIC_API_KEY=                   # Required when LLM_BACKEND=claude
GLADIA_API_KEY=                      # Required when STT_BACKEND=gladia (prod primary)
DEEPGRAM_API_KEY=                    # Required when STT_BACKEND=deepgram (prod fallback)
ELEVENLABS_API_KEY=                  # Required when TTS_BACKEND=elevenlabs (Pro)
OPENAI_API_KEY=                      # Required when TTS_BACKEND=openai (Free fallback)

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./aria_dev.db
# Production: postgresql+asyncpg://user:pass@supabase-host:5432/aria

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Production: rediss://default:token@upstash-host:6380

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Feature flags ─────────────────────────────────────────────────────────────
FEATURE_ELEVENLABS_TTS=false
FEATURE_GRAMMAR_WORKSHOP=true
FEATURE_TEXT_UPLOAD=true
FEATURE_FLASHCARDS=true
FEATURE_SESSION_REPLAY=false
FEATURE_TEAM_DASHBOARD=false

# ── Audio storage (opt-in session replay — Phase 9) ──────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=aria-audio
AUDIO_RETENTION_DAYS=30

# ── Stripe (Phase 9 monetization) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
